| `openbao_metric_samples("kube_pod_container_status_ready")`
| where metric_name="kube_pod_container_status_ready"
| search pod=$pod|s$ container=$container|s$
| stats min(value) AS value BY bucket_time pod cluster
| eval _time=bucket_time, series=pod ." | ".cluster
| timechart span=15s min(value) BY series limit=20 useother=f cont=f
