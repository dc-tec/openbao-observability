| `openbao_metric_samples("vault_database_*")`
| where metric_name="vault_database_NewUser_count" OR metric_name="vault_database_UpdateUser_count" OR metric_name="vault_database_DeleteUser_count"
| eval series=case(metric_name="vault_database_NewUser_count","create",metric_name="vault_database_UpdateUser_count","renew",metric_name="vault_database_DeleteUser_count","revoke") ." | ".coalesce(openbao_namespace,"(missing)") ." | ".cluster ." | ".scrape_profile
| `openbao_metric_rate5m`
| stats sum(value) AS value BY bucket_time cluster scrape_profile series
| eval _time=bucket_time
| timechart span=15s max(value) BY series limit=20 useother=f cont=f
