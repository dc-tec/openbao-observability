| `openbao_metric_samples("vault_route_*")`
| where metric_name="vault_route_create_kv_v1__count" OR metric_name="vault_route_read_kv_v1__count" OR metric_name="vault_route_list_kv_v1__count" OR metric_name="vault_route_delete_kv_v1__count"
| eval series=case(metric_name="vault_route_create_kv_v1__count","create",metric_name="vault_route_read_kv_v1__count","read",metric_name="vault_route_list_kv_v1__count","list",metric_name="vault_route_delete_kv_v1__count","delete") ." | ".coalesce(openbao_namespace,"(missing)") ." | ".cluster ." | ".scrape_profile
| `openbao_metric_rate5m`
| stats sum(value) AS value BY bucket_time cluster scrape_profile series
| eval _time=bucket_time
| timechart span=15s max(value) BY series limit=20 useother=f cont=f
