| `openbao_metric_samples("vault_secret_kv_count")`
| where metric_name="vault_secret_kv_count"
| sort 0 _time
| streamstats time_window=30m max(value) AS value BY _timeseries
| eval series=openbao_namespace ." | ".cluster ." | ".scrape_profile
| stats max(value) AS value BY bucket_time cluster scrape_profile series mount_point
| stats sum(value) AS value BY bucket_time cluster scrape_profile series
| eval _time=bucket_time
| timechart span=15s max(value) BY series limit=20 useother=f cont=f
