`openbao_audit_events`
| search request_path=$mount_path|s$
| where audit_type="response" AND len(mvjoin(audit_error,""))>0 AND match(request_path,"^.+/(roles|issue|issuer|issuers|root|cert|certs|tidy|revoke|crl|config|intermediate|sign|sign-verbatim)(/|$)")
| sort 100 - _time
| table _time host audit_type request_id logical_namespace request_path operation caller client_ip audit_error
