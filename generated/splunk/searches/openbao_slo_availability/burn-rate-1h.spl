| `openbao_metric_samples("probe_success")`
| where metric_name="probe_success"
| search job=$probe_job|s$
| stats avg(value) AS value BY _timeseries cluster
| stats avg(value) AS value BY cluster
| eval objective=tonumber($slo_target|s$)
| where objective>0 AND objective<1
| eval value=((1-value)/(1-objective))
| fields value
