| `openbao_metric_samples("vault_runtime_total_gc_pause_ns")`
| where metric_name="vault_runtime_total_gc_pause_ns"
| eval series=case(metric_name="vault_runtime_total_gc_pause_ns","runtime_total_gc_pause_ns") ." | ".coalesce(openbao_namespace,"(missing)") ." | ".instance ." | ".cluster ." | ".scrape_profile
| stats max(value) AS value BY bucket_time cluster scrape_profile series
| eval _time=bucket_time
| timechart span=15s max(value) BY series limit=20 useother=f cont=f
