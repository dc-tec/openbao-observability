| `openbao_metric_samples("vault_runtime_heap_objects")`
| where metric_name="vault_runtime_heap_objects"
| eval series=case(metric_name="vault_runtime_heap_objects","runtime_heap_objects") ." | ".coalesce(openbao_namespace,"(missing)") ." | ".instance ." | ".cluster ." | ".scrape_profile
| stats max(value) AS value BY bucket_time cluster scrape_profile series
| eval _time=bucket_time
| timechart span=15s max(value) BY series limit=20 useother=f cont=f
