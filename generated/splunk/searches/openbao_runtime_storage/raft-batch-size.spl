| `openbao_metric_samples("vault_raft_fsm_applyBatchNum_*")`
| where metric_name="vault_raft_fsm_applyBatchNum_sum" OR metric_name="vault_raft_fsm_applyBatchNum_count"
| eval series=case(metric_name="vault_raft_fsm_applyBatchNum_sum","raft_fsm_applyBatchNum",metric_name="vault_raft_fsm_applyBatchNum_count","raft_fsm_applyBatchNum") ." | ".coalesce(openbao_namespace,"(missing)") ." | ".instance ." | ".cluster ." | ".scrape_profile
| `openbao_metric_rate5m`
| stats sum(eval(if(match(metric_name,"_sum$"),value,null()))) AS total sum(eval(if(match(metric_name,"_count$"),value,null()))) AS observations BY bucket_time cluster scrape_profile series
| where observations>0
| eval value=total/observations
| eval _time=bucket_time
| timechart span=15s max(value) BY series limit=20 useother=f cont=f
