| `openbao_metric_samples("vault_runtime_gc_pause_ns_*")`
| where metric_name="vault_runtime_gc_pause_ns_sum" OR metric_name="vault_runtime_gc_pause_ns_count"
| eval series=case(metric_name="vault_runtime_gc_pause_ns_sum","runtime_gc_pause_ns",metric_name="vault_runtime_gc_pause_ns_count","runtime_gc_pause_ns") ." | ".coalesce(openbao_namespace,"(missing)") ." | ".cluster ." | ".scrape_profile
| `openbao_metric_rate5m`
| stats sum(eval(if(match(metric_name,"_sum$"),value,null()))) AS total sum(eval(if(match(metric_name,"_count$"),value,null()))) AS observations BY bucket_time cluster scrape_profile series
| where observations>0
| eval value=total/observations
| eval _time=bucket_time
| timechart span=15s max(value) BY series limit=20 useother=f cont=f
