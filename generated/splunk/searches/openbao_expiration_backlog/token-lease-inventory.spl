| `openbao_metric_samples("vault_*")`
| where metric_name="vault_token_count" OR metric_name="vault_expire_num_leases" OR metric_name="vault_expire_num_irrevocable_leases"
| sort 0 _time
| streamstats time_window=30m max(value) AS historical BY _timeseries
| eval value=if(match(metric_name,"_token_count$"),historical,value), series=metric_name ." | ".openbao_namespace ." | ".cluster ." | ".scrape_profile
| stats max(value) AS value BY bucket_time cluster scrape_profile series
| eval _time=bucket_time
| timechart span=15s max(value) BY series limit=20 useother=f cont=f
