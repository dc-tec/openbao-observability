| `openbao_metric_samples("vault_core_mount_table_num_entries")`
| where metric_name="vault_core_mount_table_num_entries"
| eval local=coalesce(local,"(missing)"), type=coalesce(type,"(missing)"), series=openbao_namespace ." | ".cluster ." | ".scrape_profile
| stats max(value) AS value BY bucket_time cluster scrape_profile series type local
| stats sum(value) AS value BY bucket_time cluster scrape_profile series
| eval _time=bucket_time
| `openbao_metric_fresh`
| stats latest(value) AS value BY cluster scrape_profile series
| stats sum(value) AS value count AS contributing_series
| where contributing_series>0
| fields - contributing_series
