| `openbao_metric_samples("vault_database_*")`
| where metric_name="vault_database_Initialize_error" OR metric_name="vault_database_NewUser_error" OR metric_name="vault_database_UpdateUser_error" OR metric_name="vault_database_DeleteUser_error" OR metric_name="vault_database_Close_error"
| eval series=case(metric_name="vault_database_Initialize_error","initialize",metric_name="vault_database_NewUser_error","create",metric_name="vault_database_UpdateUser_error","renew",metric_name="vault_database_DeleteUser_error","revoke",metric_name="vault_database_Close_error","close") ." | ".coalesce(openbao_namespace,"(missing)") ." | ".cluster ." | ".scrape_profile
| `openbao_metric_rate15m`
| eval value=value*900
| stats sum(value) AS value BY bucket_time cluster scrape_profile series
| eval _time=bucket_time
| `openbao_metric_fresh`
| stats latest(value) AS value BY cluster scrape_profile series
| stats sum(value) AS value count AS contributing_series
| where contributing_series>0
| fields - contributing_series
