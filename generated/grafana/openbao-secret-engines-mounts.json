          "expr": "sum(count_over_time({log_stream=\"openbao.audit\", node_id=~\"${node_id:raw}\"} | json operation=\"request.operation\", request_id=\"request.id\", request_path=\"request.path\" | request_path=~\"(secret|kv-v1|database|transit|pki)(/.*)?\" | request_path=~\"${engine_path:raw}\" | request_id=~\"${request_id:raw}\" | operation=~\"${operation:raw}\" [5m]))",
