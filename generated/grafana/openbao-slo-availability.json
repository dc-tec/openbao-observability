  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Shows whether the selected synthetic OpenBao probes currently succeed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Failing"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Passing"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "gray",
                  "index": 2,
                  "text": "Probe missing"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "Probe missing",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (cluster) (probe_success{cluster=~\"${cluster:raw}\",job=~\"${probe_job:raw}\",instance=~\"${probe_target:raw}\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{cluster}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Probe success",
      "type": "stat"
    },
