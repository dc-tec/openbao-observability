logging {
  level  = "info"
  format = "logfmt"
}

loki.source.file "openbao_node0_operational" {
  targets = [
    {
      __path__              = "/var/lib/openbao/node0/logs/openbao.log",
      "cluster"            = "compose",
      "component"          = "openbao",
      "deployment_profile" = "docker-compose",
      "environment"        = "local",
      "instance"           = "openbao-node0",
      "log_stream"         = "openbao.operational",
      "node_id"            = "node0",
      "pod"                = "openbao-node0",
    },
  ]
  forward_to = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.source.file "openbao_node0_audit" {
  targets = [
    {
      __path__              = "/var/lib/openbao/node0/audit/audit.jsonl",
      "cluster"            = "compose",
      "component"          = "openbao",
      "deployment_profile" = "docker-compose",
      "environment"        = "local",
      "instance"           = "openbao-node0",
      "log_stream"         = "openbao.audit",
      "node_id"            = "node0",
      "pod"                = "openbao-node0",
    },
  ]
  forward_to = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

